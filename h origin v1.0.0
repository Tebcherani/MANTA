[1mdiff --git a/docs/manta_sim_sequence.puml b/docs/manta_sim_sequence.puml[m
[1mnew file mode 100644[m
[1mindex 0000000..83b36e9[m
[1m--- /dev/null[m
[1m+++ b/docs/manta_sim_sequence.puml[m
[36m@@ -0,0 +1,129 @@[m
[32m+[m[32m@startuml[m
[32m+[m[32mtitle MANTA ROS 2 Simulation Sequence Diagram[m
[32m+[m
[32m+[m[32mskinparam monochrome true[m
[32m+[m[32mskinparam shadowing false[m
[32m+[m[32mskinparam sequenceMessageAlign center[m
[32m+[m[32mskinparam responseMessageBelowArrow true[m
[32m+[m
[32m+[m[32mactor "Launch system" as Launcher[m
[32m+[m[32mparticipant "SimOrchestratorNode" as Orchestrator[m
[32m+[m[32mparticipant "WhaleNode" as Whale[m
[32m+[m[32mparticipant "OdysseyNode\n(one per vehicle)" as Odyssey[m
[32m+[m[32mparticipant "OdysseyDetectionNode" as Detection[m
[32m+[m
[32m+[m[32m== Node construction ==[m
[32m+[m
[32m+[m[32mLauncher -> Orchestrator : Construct node[m
[32m+[m[32mactivate Orchestrator[m
[32m+[m[32mOrchestrator -> Orchestrator : Load vehicle list[m
[32m+[m[32mOrchestrator -> Orchestrator : Create ROS interfaces[m
[32m+[m[32mOrchestrator -> Orchestrator : Initialize simulation[m
[32m+[m[32mOrchestrator -> Orchestrator : Initialize world state[m
[32m+[m[32mdeactivate Orchestrator[m
[32m+[m
[32m+[m[32mLauncher -> Whale : Construct node[m
[32m+[m[32mactivate Whale[m
[32m+[m[32mWhale -> Whale : Load whale configuration[m
[32m+[m[32mWhale -> Whale : Generate whale groups[m
[32m+[m[32mWhale -> Whale : Create whales[m
[32m+[m[32mWhale -> Whale : Generate whale trajectories[m
[32m+[m[32mWhale -> Whale : Generate whale call times[m
[32m+[m[32mWhale -> Whale : Create ROS interfaces[m
[32m+[m[32mdeactivate Whale[m
[32m+[m
[32m+[m[32mLauncher -> Odyssey : Construct each vehicle node[m
[32m+[m[32mactivate Odyssey[m
[32m+[m[32mOdyssey -> Odyssey : Load vehicle configuration[m
[32m+[m[32mOdyssey -> Odyssey : Create ROS interfaces[m
[32m+[m[32mdeactivate Odyssey[m
[32m+[m
[32m+[m[32mLauncher -> Detection : Construct node[m
[32m+[m[32mactivate Detection[m
[32m+[m[32mDetection -> Detection : Load detection configuration[m
[32m+[m[32mDetection -> Detection : Create ROS interfaces[m
[32m+[m[32mdeactivate Detection[m
[32m+[m
[32m+[m[32m== Vehicle initialization ==[m
[32m+[m
[32m+[m[32mOrchestrator ->> Odyssey : Startup signal[m
[32m+[m[32mactivate Odyssey[m
[32m+[m[32mOdyssey -> Odyssey : Initialize vehicle simulation[m
[32m+[m[32mdeactivate Odyssey[m
[32m+[m
[32m+[m[32mOrchestrator ->> Odyssey : Initial simulation time[m
[32m+[m[32mactivate Odyssey[m
[32m+[m[32mOdyssey -> Odyssey : Initialize vehicle simulation time[m
[32m+[m[32mdeactivate Odyssey[m
[32m+[m
[32m+[m[32mOrchestrator ->> Odyssey : Calendar start time[m
[32m+[m[32mactivate Odyssey[m
[32m+[m[32mOdyssey -> Odyssey : Initialize mission[m
[32m+[m[32mOdyssey -> Odyssey : Initialize vehicle[m
[32m+[m[32mOdyssey -> Odyssey : Initialize world state[m
[32m+[m[32mOdyssey ->> Orchestrator : Vehicle ready[m
[32m+[m[32mdeactivate Odyssey[m
[32m+[m
[32m+[m[32mactivate Orchestrator[m
[32m+[m[32mOrchestrator -> Orchestrator : Wait for all vehicles[m
[32m+[m[32mOrchestrator -> Orchestrator : Start simulation[m
[32m+[m
[32m+[m[32m== Simulation loop ==[m
[32m+[m
[32m+[m[32m    loop Until simulation or all missions are complete[m
[32m+[m
[32m+[m[32m    Orchestrator -> Whale : Request next whale call[m
[32m+[m[32m    deactivate Orchestrator[m
[32m+[m
[32m+[m[32m    activate Whale[m
[32m+[m[32m    Whale -> Whale : Find first call after current time[m
[32m+[m[32m    Whale --> Orchestrator : Next whale call[m
[32m+[m[32m    deactivate Whale[m
[32m+[m
[32m+[m[32m    Orchestrator -> Orchestrator : Store next whale call[m
[32m+[m
[32m+[m[32m    Orchestrator ->> Whale : Advance by the specified number of simulation cycles[m
[32m+[m[32m    activate Whale[m
[32m+[m[32m    Whale -> Whale : Update whale positions and lifecycle[m
[32m+[m[32m    deactivate Whale[m
[32m+[m
[32m+[m[32m    Orchestrator ->> Odyssey : Advance by the specified number of simulation cycles[m
[32m+[m[32m    activate Odyssey[m
[32m+[m[32m    Odyssey -> Odyssey : Update world state[m
[32m+[m[32m    Odyssey -> Odyssey : Advance vehicle dynamics[m
[32m+[m
[32m+[m[32m    Odyssey ->> Detection : Vehicle state[m
[32m+[m[32m    activate Detection[m
[32m+[m
[32m+[m[32m    Odyssey ->> Orchestrator : Simulation step complete signal[m
[32m+[m[32m    deactivate Odyssey[m
[32m+[m
[32m+[m[32m    Orchestrator -> Orchestrator : Record result for each vehicle[m
[32m+[m[32m    Orchestrator -> Orchestrator : Wait for all vehicles[m
[32m+[m
[32m+[m[32m    Orchestrator -> Detection : Whale call[m
[32m+[m[32m    Detection -> Detection : Wait for all vehicle states[m
[32m+[m[32m    Detection -> Detection : Evaluate detection for each vehicle[m
[32m+[m[32m    Detection ->> Orchestrator : Whale call processed signal[m
[32m+[m[32m    deactivate Detection[m
[32m+[m
[32m+[m[32m    Orchestrator -> Whale : Request next whale call[m
[32m+[m[32m    activate Whale[m
[32m+[m[32m    Whale -> Whale : Find first call after current time[m
[32m+[m[32m    Whale --> Orchestrator : Next whale call[m
[32m+[m[32m    deactivate Whale[m
[32m+[m
[32m+[m[32m    Orchestrator -> Orchestrator : Store following whale call[m
[32m+[m[32mend[m
[32m+[m
[32m+[m[32m== Shutdown ==[m
[32m+[m
[32m+[m[32mOrchestrator ->> Whale : Shutdown request[m
[32m+[m[32mOrchestrator ->> Odyssey : Shutdown request[m
[32m+[m[32mactivate Odyssey[m
[32m+[m[32mOdyssey -> Odyssey : Write final vehicle metrics[m
[32m+[m[32mdeactivate Odyssey[m
[32m+[m
[32m+[m[32mOrchestrator ->> Detection : Shutdown request[m
[32m+[m
[32m+[m[32m@enduml[m
\ No newline at end of file[m
