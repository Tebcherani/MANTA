@startuml
title MANTA ROS 2 Simulation Sequence Diagram

skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor "Launch system" as Launcher
participant "SimOrchestratorNode" as Orchestrator
participant "WhaleNode" as Whale
participant "OdysseyNode\nauv_1" as AUV1
participant "OdysseyNode\nauv_2" as AUV2
participant "WhaleDetectionNode" as Detection

== Node construction ==

Launcher -> Orchestrator : Construct node
Orchestrator -> Orchestrator : Load vehicle list and simulation configuration
Orchestrator -> Orchestrator : Initialize simulation and world state
Orchestrator -> Orchestrator : Create ROS interfaces

Launcher -> Whale : Construct node
Whale -> Whale : Load whale configuration
Whale -> Whale : Generate groups and create whales
Whale -> Whale : Generate trajectories and call times
Whale -> Whale : Create ROS interfaces

Launcher -> AUV1 : Construct node
AUV1 -> AUV1 : Load vehicle configuration
AUV1 -> AUV1 : Create ROS interfaces

Launcher -> AUV2 : Construct node
AUV2 -> AUV2 : Load vehicle configuration
AUV2 -> AUV2 : Create ROS interfaces

Launcher -> Detection : Construct node
Detection -> Detection : Load detection configuration
Detection -> Detection : Create ROS interfaces

== Vehicle initialization ==

Orchestrator ->> AUV1 : Startup ready, initial time, calendar time
AUV1 -> AUV1 : Initialize native simulation, time,\nmission, vehicle, and world
AUV1 ->> Orchestrator : Vehicle ready

Orchestrator ->> AUV2 : Startup ready, initial time, calendar time
AUV2 -> AUV2 : Initialize native simulation, time,\nmission, vehicle, and world
AUV2 ->> Orchestrator : Vehicle ready

Orchestrator -> Orchestrator : Wait until both vehicles are ready

== Simulation loop ==

loop

    Orchestrator -> Whale : Request first call after supplied time
    Whale -> Whale : Find next scheduled call
    Whale --> Orchestrator : Next call or no future call

    Orchestrator ->> Whale : Simulation step 
    Whale -> Whale : Update whale positions and lifecycle

    Orchestrator ->> AUV1 : Simulation step
    AUV1 -> AUV1 : Advance vehicle dynamics
    AUV1 -> AUV1 : Update sensors and navigation
    AUV1 -> AUV1 : Predict whale position at current simulation time\nusing stored position and velocity
    AUV1 -> AUV1 : Set next waypoint
    AUV1 -> AUV1 : Update simulation time
    AUV1 -> AUV1 : Save completed position snapshot
    AUV1 ->> Detection : VehicleState (ID, cycle, time, position)
    AUV1 ->> Orchestrator : SimStepResult

    Orchestrator ->> AUV2 : Simulation step 
    AUV2 -> AUV2 : Advance vehicle dynamics
    AUV2 -> AUV2 : Update sensors and navigation
    AUV2 -> AUV2 : Predict whale position at current simulation time\nusing stored position and velocity
    AUV2 -> AUV2 : Set next waypoint
    AUV2 -> AUV2 : Update simulation time
    AUV2 -> AUV2 : Save completed position snapshot
    AUV2 ->> Detection : VehicleState (ID, cycle, time, position)
    AUV2 ->> Orchestrator : SimStepResult

    Orchestrator -> Orchestrator : Record results and wait\nfor all active vehicles
    Orchestrator -> Orchestrator : Check termination conditions and advance shared clock

    Orchestrator ->> Detection : Whale call (ID, cycle, time, position)

    Detection -> Detection : Wait for all vehicle states\nmatching the call cycle
    Detection -> Detection : Evaluate range 
    Detection -> Detection : Check reception interval\nfor each in-range vehicle
    Detection -> Detection : Calculate bearings for accepted calls

    Detection ->> AUV1 : BearingObservation
    AUV1 -> AUV1 : Find own position snapshot\nmatching call cycle
    AUV1 ->> AUV2 : BearingMsg
    
    AUV2 -> AUV2 : Find own position snapshot\nmatching call cycle
    AUV2 ->> AUV1 : BearingMsg

    Detection ->> Orchestrator : WhaleCallProcessed

    AUV1 -> AUV1 : Supply own measurement locally
    AUV1 -> AUV1 : Collect pair and triangulate
    AUV1 -> AUV1 : Apply target
    AUV1 ->> Orchestrator : BearingProcessed

    AUV2 -> AUV2 : Supply own measurement locally
    AUV2 -> AUV2 : Collect pair and triangulate
    AUV2 -> AUV2 : Apply target
    AUV2 ->> Orchestrator : BearingProcessed

    Orchestrator -> Orchestrator : Wait for detector completion and estimator acknowledgments
end

== Shutdown ==

Orchestrator ->> Whale : Shutdown request
Orchestrator ->> AUV1 : Shutdown request
Orchestrator ->> AUV2 : Shutdown request
Orchestrator ->> Detection : Shutdown request

Orchestrator -> Orchestrator : Shutdown

@enduml