@startuml
title WhaleDetectionNodeClass Diagram

skinparam classAttributeIconSize 0
skinparam monochrome true
skinparam shadowing false

class OdysseyDetectionNode <<ROS node>> {
    ' Attributes

    - pending_call_available : bool

    - pending_call_ : WhaleCall
    - latest_vehicle_states_ : map<string, VehicleState>

    - vehicle_ids_ : vector<string>
    - detection_range_ : double
    - detection_log_ : ofstream

    ' Operations

    - create_ros_interfaces() : void
    - load_config() : void
    - open_detection_log() : void

    - handle_shutdown(msg : bool) : void
    - handle_vehicle_state(msg : VehicleState, vehicle_id : string) : void
    - handle_whale_call(call : WhaleCall) : void

    - try_process_pending_call() : void
}

together {
    class VehicleState <<ROS message>> {
        vehicle_id : string
        cycle : int
        sim_time : float
        --
        north : float
        east : float
        depth : float
    }

    class WhaleCall <<ROS message>> {
        --
        + whale_id : string
        + cycle : int
        + sim_time : float
        + north : float 
        + east : float
        + depth : float
    }
}

OdysseyDetectionNode *-- VehicleState
OdysseyDetectionNode ..> VehicleState
OdysseyDetectionNode *-- WhaleCall

@enduml