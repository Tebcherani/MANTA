@startuml
title WhaleNode Class Diagram

skinparam classAttributeIconSize 0
skinparam monochrome true
skinparam shadowing false

class WhaleNode <<ROS node>> {
    ' Operations

    - load_config() : void
    - initialize_whale_groups(line_length : double) : void
    - initialize_whale_dynamics(whale : Whale, initial_state : WhaleInitialState, speed : double, line : LineGeometry, group : WhaleGroup)
    - initialize_whales() : void
    - open_whale_log() : void
    - seed_generator() : void
    - validate_config() : void

    - compute_initial_state(group : WhaleGroup, line : LineGeometry, crossing_distance : double, speed : double) : WhaleInitialState
    - compute_line_geometry() : LineGeometry
    - create_whale(whale_index : size_t, group_index : size_t, group : WhaleGroup, start_time : double, call_rate : double) : Whale
    - generate_call_times(start_time : double, end_time : double, call_rate_per_hour : double, group : WhaleGroup) : vector<double>
    - generate_trajectory(initial_north : double, initial_east : double, crossing_heading : double, speed : double, start_time : double, perpendicular_north : double, perpendicular_east : double, group : WhaleGroup) : vector<TrajectoryPoint>
    - get_group_index_for_whale(whale_index : size_t) : size_t
    - get_group_for_whale(whale_index : size_t) : WhaleGroup
    - sample_crossing_distance(group : WhaleGroup, line_length : double) : double
    - sample_start_time(group : WhaleGroup) : double
    - sample_speed() : double

    - handle_get_next_call(request : GetNextWhaleCall, response : GetNextWhaleCall) : void
    - handle_shutdown(msg : bool) : void
    - handle_sim_step(step : SimStep) : void

    - trajectory_at_time(whale : Whale, time : double) : TrajectoryPoint
    - update_whales(step : SimStep) : void

    ' Attributes

    - next_whale_log_time_ : double
    - whale_log_ : ofstream
    - whale_sample_period_ : double

    - generator_ : mt19937
    - mission_duration_ : double

    - line_start_north_ : double
    - line_start_east_ : double
    - line_end_north_ : double
    - line_end_east_ : double

    - whale_groups_ : vector<WhaleGroup>
    - group_mean_size_ : double
    - group_position_std_ : double
    - group_start_time_std_ : double
    - shared_heading_fraction_ : double

    - heading_correlation_ : double
    - heading_std_degrees_ : double
    - speed_mean_ : double
    - speed_std_ : double
    - turn_interval_ : double

    - call_activity_correlation_ : double
    - call_activity_interval_ : double
    - call_rate_min_ : double
    - call_rate_max_ : double
    - group_log_rate_std_ : double

    - whales_ : vector<Whale>
    - start_distance_ : double
    - whale_depth_ : double
    - whale_count_ : int
}

together {
    class "LineGeometry" <<C++ structure>> {
        + length : double 

        + along_north : double 
        + along_east : double 

        + perpendicular_north : double 
        + perpendicular_east : double
    }

    class TrajectoryPoint <<C++ structure>> {
        + time : double
        + north : double 
        + east : double 

        + velocity_north : double 
        + velocity_east : double
    }

    class "Whale" <<C++ structure>> {
        + active : bool 
        + complete : bool 

        + id : string 
        + group_index : int 

        + start_time : double 
        + starting_side : double

        + north : double 
        + east : double 
        + depth : double 
        + trajectory : vector<TrajectoryPoint>
        
        + velocity_north : double 
        + velocity_east : double 

        + call_rate_per_hour : double 
        + call_times : vector<double> 
        + next_call_index : size_t 
    }

    class WhaleInitialState <<C++ structure>> {
        + north : double 
        + east : double 
        + heading : double
    }

    class WhaleGroup <<C++ structure>> {
        + crossing_distance : double 
        + side : double 
        + start_time : double 

        + heading_errors : vector<double> 
        + call_rate_multipliers : vector<double>
    }
}

together {
    class SimStep <<ROS message>> {
        --
        + current_cycle : int
        + sim_time : float
        + timestep : float
        + step_count : int
        + control_period : int
        + world : WorldState
    }

    class WhaleCall <<ROS message>> {
        --
        + whale_id : string
        + cycle : int
        + sim_time : float
        + north : float 
        + east : float
        + depth : float
    }

    class WhaleState <<ROS message>> {
        --
        + active : bool 
        + calling : bool 

        + whale_id : string 
        + cycle : int 
        
        + north : float 
        + east : float 
        + depth : float 

        + velocity_north : float 
        + velocity_east : float 
        + velocity_down : float 
    }

    class WorldState <<ROS message>> {
        + gravity : float
        + magnetic_north : float
        + magnetic_east : float
        + magnetic_down : float
        + seawater_density : float
    }
}

WhaleNode ..> SimStep
SimStep *-- WorldState 
WhaleNode *-- WhaleGroup 
WhaleNode *-- Whale 
Whale *-- TrajectoryPoint 
WhaleNode ..> LineGeometry
WhaleNode ..> WhaleInitialState 
Whale ..> WhaleGroup

@enduml