@startuml
title WhaleNode Constructor Activity Diagram

skinparam monochrome true
skinparam shadowing false
skinparam svgLinkTarget _self

start

partition "WhaleNode()" {
    :Load whale-model configuration;
    note right
        - Mission geometry and duration
        - Whale count, distance, grouping, movement, and calling
    end note

    :Open whale state log;
    :Seed random number generator;

    partition "Initialize whales" {
        :Compute picket line geometry;

        partition "Place whales in groups" {
            :Calculate number of groups;
            :Calculate number of heading changes;
            :Create probability distributions;

            partition "Generate whale groups" {
                :Generate groups' crossing location;
                note right: Uni(0, 126km)

                :Generate groups' starting side;
                note right: Bernoulli(0.5)

                :Generate groups' start time;
                note right: Uni(0, 3 days)

                :Generate groups' heading changes;
                note right
                    Gaussian AR(1) process
                    - rho = 0.95
                    - update interval = 60 s
                    - stationary STD = heading_std_degrees_
                    - initial error = 0 degrees
                end note
            }
        }

        partition "Create individual whales" {
            :Create distributions;

            :Select whale group;
            :Sample crossing distance;
            note right: Normal(0, 1000km)

            :Sample start time;
            note right: Normal(0, 10 min)

            :Sample swimming speed;
            note right: Normal(1.5, 0.2m/s)

            :Sample baseline call rate;
            note right: Uni(4.8, 8.0 calls/hr)

            :Compute initial position and heading;
            :Create whale and assign properties;

            partition "Generate movement trajectory" {
                :Calculate individual AR(1) heading innovation scale;
                note right
                    - Heading STD = 15 deg
                    - Heading correlation = 0.95
                end note

                :Calculate group and individual\nheading weights;
                note right
                    - Shared heading fraction = 0.75
                    - Group weight = sqrt(0.75)
                    - Individual weight = sqrt(0.25)
                end note

                :Initialize time and position;

                while (Trajectory complete?) is (no)
                    :Calculate heading;
                    note right: - Shared heading fraction = 0.75

                    :Calculate velocity;
                    :Store next trajectory point;

                    if (Mission duration reached?) then (yes)
                        break
                    else (no)
                        :Determine next heading update;
                        :Move using current velocity until next update time;
                        :Calculate distance from picket line;

                        if (Whale exited corridor?) then (yes)
                            :Store final position with zero velocity;
                            break
                        else (no)
                            :Update individual AR(1) heading error;
                        endif
                    endif
                endwhile(no)
            }

            :Initialize published position\nand velocity;
            :Store whale in population;

            partition "Generate population call times" {
                :Determine population activity interval;
                note right
                    From first whale activation
                    through last whale's trajectory end
                end note

                :Select initial active or silent state;
                note right
                    The simulation begins active with probability 0.19.

                    This probability is the estimated fraction of time
                    spent in active calling bouts:

                    30.7 min active / (30.7 min active + 131 min silent) = 0.19

                    The 30.7 min active duration is reported by the paper.
                    The 131 min silent duration is derived from the paper's
                    total bouts and acoustically positive recorder-days.
                end note

                    while (Population calling interval remains?) is (yes)
                        if (Population is in an active bout?) then (yes)
                            :Sample active-bout duration;
                            note right
                                Exponential distribution
                                Mean = 1,842 s (30.7 min)
                            end note

                            :Generate calls during active bout;
                            note right
                                Poisson process
                                Rate = 40.1 calls/h
                            end note
                        else (no)
                            :Sample silent duration;
                            note right
                                Exponential distribution
                                Mean = 7,860 s (approximately 2.18 h)
                            end note
                        endif

                        :Switch between active and silent states;
                    endwhile (no)
                }

                partition "Assign calls to whales" {
                    while (More population calls?) is (yes)
                        :Find whales active at call time;

                        if (At least one whale is active?) then (yes)
                            :Select one active whale uniformly;
                            :Add call time to selected whale;
                        else (no)
                            :Discard call;
                        endif
                    endwhile (no)
                }
        }
    }

    partition "Create ROS interfaces" {
        :Create publisher;
        note right
            - Whale states
        end note

        :Create subscribers;
        note right
            - Simulation step
            - Shutdown request
        end note

        :Create service;
        note right
            - Get next whale call
        end note
    }

    #A8DFA8:Whale population initialized;
    note right
        Log the number of initialized whales.
    end note
}

stop

@enduml