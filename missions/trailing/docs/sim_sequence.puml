@startuml
title MANTA Trailing Mission — Sequential Whale Step and Bearing Estimation

skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

participant "SimOrchestratorNode" as Orchestrator
participant "WhaleNode" as Whale
participant "WhaleDetectionNode" as Detection
participant "OdysseyNode\nauv_1" as AUV1
participant "OdysseyNode\nauv_2" as AUV2
participant "WhaleEstimatorNode\nauv_1" as Estimator1
participant "WhaleEstimatorNode\nauv_2" as Estimator2

== Initialization ==

Orchestrator ->> AUV1 : Startup ready, initial simulation time, calendar time
Orchestrator ->> AUV2 : Startup ready, initial simulation time, calendar time
AUV1 -> AUV1 : Initialize Odyssey and trailing mission
AUV2 -> AUV2 : Initialize Odyssey and trailing mission
AUV1 ->> Orchestrator : Vehicle ready
AUV2 ->> Orchestrator : Vehicle ready
Whale ->> Orchestrator : Whale ready
Detection ->> Orchestrator : Detector ready
Orchestrator -> Orchestrator : Wait for vehicles, estimators, whale, and detector

== Trailing simulation ==

loop Until mission termination
    Orchestrator ->> Whale : Whale SimStep (maximum batch size)
    Whale -> Whale : Stop at the next scheduled call, if one occurs
    Whale -> Whale : Advance whale positions and publish ground truth
    opt A whale calls during this batch
        Whale ->> Detection : WhaleCall (position, cycle, time)
    end
    Whale ->> Orchestrator : WhaleStepResult (completed steps, optional call)

    Orchestrator ->> AUV1 : Vehicle SimStep (completed whale steps)
    Orchestrator ->> AUV2 : Vehicle SimStep (completed whale steps)
    AUV1 -> AUV1 : Advance dynamics and update trailing control
    AUV2 -> AUV2 : Advance dynamics and update trailing control
    opt Scheduled communication time
        AUV1 ->> AUV2 : Bearing or no-bearing notice
        AUV2 ->> AUV1 : Bearing or no-bearing notice
            end
    AUV1 ->> Detection : VehicleState
    AUV2 ->> Detection : VehicleState
    opt A whale call was published
        Detection -> Detection : Match vehicle states to call cycle
        Detection -> Detection : Check range and calculate noisy bearings
        Detection ->> AUV1 : BearingObservation (if detected)
        Detection ->> AUV2 : BearingObservation (if detected)
        Detection ->> AUV1 : WhaleCallProcessed (receiver IDs)
        Detection ->> AUV2 : WhaleCallProcessed (receiver IDs)
        AUV1 -> AUV1 : Handle bearing, if detected
        AUV2 -> AUV2 : Handle bearing, if detected
    end
    opt Same-cycle local and remote bearings available on auv_1
        AUV1 -> AUV1 : Triangulate whale position and variance
        AUV1 ->> Estimator1 : WhaleBearingPositionEstimate
        Estimator1 -> Estimator1 : Predict, correct, and fit recent velocity
        Estimator1 ->> AUV1 : WhaleKalmanEstimate
        AUV1 -> AUV1 : Cache estimate for trailing guidance
    end

    opt Same-cycle local and remote bearings available on auv_2
        AUV2 -> AUV2 : Triangulate whale position and variance
        AUV2 ->> Estimator2 : WhaleBearingPositionEstimate
        Estimator2 -> Estimator2 : Predict, correct, and fit recent velocity
        Estimator2 ->> AUV2 : WhaleKalmanEstimate
        AUV2 -> AUV2 : Cache estimate for trailing guidance
    end
    AUV1 ->> Orchestrator : SimStepResult (after peer exchange, if scheduled)
    AUV2 ->> Orchestrator : SimStepResult (after peer exchange, if scheduled)
    Orchestrator -> Orchestrator : Wait for active vehicle step results; advance shared clock


end

== Shutdown ==

Orchestrator ->> Whale : Shutdown
Orchestrator ->> Detection : Shutdown
Orchestrator ->> AUV1 : Shutdown
Orchestrator ->> AUV2 : Shutdown
Orchestrator ->> Estimator1 : Shutdown
Orchestrator ->> Estimator2 : Shutdown

@enduml
