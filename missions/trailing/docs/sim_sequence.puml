@startuml
title MANTA Trailing Mission — Scheduled Bearings and Whale Estimation

skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

participant "SimOrchestratorNode" as Orchestrator
participant "WhaleNode" as Whale
participant "WhaleDetectionNode" as Detection
participant "OdysseyNode\nauv_1" as AUV1
participant "OdysseyNode\nauv_2" as AUV2
participant "WhaleEstimatorNode\nauv_1" as Estimator1
participant "WhaleEstimatorNode\nauv_2" as Estimator2

== Initialization ==

Orchestrator ->> AUV1 : Startup ready, initial simulation time, calendar time
AUV1 -> AUV1 : Initialize Odyssey and trailing mission
AUV1 ->> Orchestrator : Vehicle ready

Orchestrator ->> AUV2 : Startup ready, initial simulation time, calendar time
AUV2 -> AUV2 : Initialize Odyssey and trailing mission
AUV2 ->> Orchestrator : Vehicle ready

Orchestrator -> Orchestrator : Wait until all configured vehicles are ready

== Trailing simulation ==

loop Until mission termination
    Orchestrator -> Whale : Request next call after current simulation time
    Whale --> Orchestrator : Next scheduled call or no future call

    par Whale simulation
        Orchestrator ->> Whale : SimStep
        Whale -> Whale : Advance whale positions
        Whale ->> Orchestrator : Step completion
    else Vehicle simulations
        Orchestrator ->> AUV1 : SimStep
        Orchestrator ->> AUV2 : SimStep
        AUV1 -> AUV1 : Advance dynamics and simulation time
        AUV2 -> AUV2 : Advance dynamics and simulation time
        AUV1 -> AUV1 : At control updates, project cached whale estimate
        AUV2 -> AUV2 : At control updates, project cached whale estimate
        AUV1 -> AUV1 : Update trailing waypoint and control
        AUV2 -> AUV2 : Update trailing waypoint and control
        AUV1 ->> Detection : VehicleState
        AUV2 ->> Detection : VehicleState
        AUV1 ->> Orchestrator : SimStepResult
        AUV2 ->> Orchestrator : SimStepResult
    end

    Orchestrator -> Orchestrator : Wait for all active vehicles' step results
    Orchestrator -> Orchestrator : Check termination and advance shared simulation clock

    opt The batch reaches a scheduled whale call
        Orchestrator ->> Detection : WhaleCall (position, cycle, simulation time)
        Detection -> Detection : Wait until vehicle states match the call cycle

        loop Each configured vehicle
            Detection -> Detection : Check horizontal detection range
            opt Vehicle is in range
                Detection -> Detection : Calculate bearing and add configured noise
                Detection ->> AUV1 : BearingObservation (if auv_1 detects)
                Detection ->> AUV2 : BearingObservation (if auv_2 detects)
            end
        end

        opt auv_1 received a bearing observation
            AUV1 -> AUV1 : Find own position at the call cycle
            AUV1 -> AUV1 : Store bearing with receiver position and call time
            AUV1 ->> Orchestrator : BearingProcessed (stored locally)
        end
        opt auv_2 received a bearing observation
            AUV2 -> AUV2 : Find own position at the call cycle
            AUV2 -> AUV2 : Store bearing with receiver position and call time
            AUV2 ->> Orchestrator : BearingProcessed (stored locally)
        end

        Detection ->> Orchestrator : WhaleCallProcessed (detected receiver IDs)
        Orchestrator -> Orchestrator : Wait for detector and detected-vehicle storage acknowledgements
    end

    opt Scheduled communication time and an unsent bearing is available
        AUV1 ->> AUV2 : BearingTransmission (bearing and call-cycle position)
        AUV2 ->> AUV1 : BearingTransmission (bearing and call-cycle position)
    end

    opt Matching bearings for the same call cycle are available on auv_1
        AUV1 -> AUV1 : Triangulate whale position and calculate position variance
        AUV1 ->> Estimator1 : WhaleBearingPositionEstimate (position, variance, cycle, time)
        Estimator1 -> Estimator1 : FilterPy predict, then update with measured position
        Estimator1 ->> AUV1 : WhaleKalmanEstimate (position, velocity, variances)
        AUV1 -> AUV1 : Cache estimate for trailing guidance
    end

    opt Matching bearings for the same call cycle are available on auv_2
        AUV2 -> AUV2 : Triangulate whale position and calculate position variance
        AUV2 ->> Estimator2 : WhaleBearingPositionEstimate (position, variance, cycle, time)
        Estimator2 -> Estimator2 : FilterPy predict, then update with measured position
        Estimator2 ->> AUV2 : WhaleKalmanEstimate (position, velocity, variances)
        AUV2 -> AUV2 : Cache estimate for trailing guidance
    end
end

== Shutdown ==

Orchestrator ->> Whale : Shutdown
Orchestrator ->> Detection : Shutdown
Orchestrator ->> AUV1 : Shutdown
Orchestrator ->> AUV2 : Shutdown
Orchestrator ->> Estimator1 : Shutdown
Orchestrator ->> Estimator2 : Shutdown

@enduml
