@startuml
title MANTA Trailing Mission — Scheduled Bearing Communication

skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

participant "SimOrchestratorNode" as Orchestrator
participant "WhaleNode" as Whale
participant "WhaleDetectionNode" as Detection
participant "OdysseyNode\nauv_1" as AUV1
participant "OdysseyNode\nauv_2" as AUV2

== Initialization ==

Orchestrator ->> AUV1 : Startup ready, initial time, calendar time
AUV1 -> AUV1 : Initialize vehicle and trailing mission
AUV1 ->> Orchestrator : Vehicle ready

Orchestrator ->> AUV2 : Startup ready, initial time, calendar time
AUV2 -> AUV2 : Initialize vehicle and trailing mission
AUV2 ->> Orchestrator : Vehicle ready

Orchestrator -> Orchestrator : Wait until both vehicles are ready

== Trailing simulation ==

loop

    Orchestrator -> Whale : Request next whale call
    Whale --> Orchestrator : Next call or no future call

    par Whale simulation
        Orchestrator ->> Whale : SimStep
        Whale -> Whale : Update whale positions
        Whale -> Whale : Publish ground truth and log trajectory

    else AUV simulation
        Orchestrator ->> AUV1 : SimStep
        AUV1 -> AUV1 : Advance dynamics and simulation time
        AUV1 -> AUV1 : At control updates, predict whale position\nfrom stored position and velocity
        AUV1 -> AUV1 : Update trailing waypoint and control

        opt Communication boundary reached and measurement available
            AUV1 ->> AUV2 : Latest bearing, receiver position, and measurement time
        end

        AUV1 ->> Detection : VehicleState
        AUV1 ->> Orchestrator : SimStepResult

        opt Matching local and remote bearings available
            AUV1 -> AUV1 : Intersect same-cycle bearings
            AUV1 -> AUV1 : Store whale position at call time
            AUV1 -> AUV1 : Update position and recent-measurement velocity estimate
        end
    end

    Orchestrator -> Orchestrator : Wait for all active vehicles' step results
    Orchestrator -> Orchestrator : Check termination; advance shared clock if continuing

    Orchestrator ->> Detection : WhaleCall (position, cycle, time)
    Detection -> Detection : Evaluate detection range and calculate bearings

    opt AUV detects call
        Detection ->> AUV1 : BearingObservation
        AUV1 -> AUV1 : Find own position at call cycle
        AUV1 -> AUV1 : Replace latest local measurement
        AUV1 ->> Orchestrator : BearingProcessed (measurement stored)
    end

        Detection ->> Orchestrator : WhaleCallProcessed (receiver IDs)
        Orchestrator -> Orchestrator : Wait for detector and local-storage acknowledgements
end

== Shutdown ==

Orchestrator ->> Whale : Shutdown
Orchestrator ->> Detection : Shutdown
Orchestrator ->> AUV1 : Shutdown
Orchestrator ->> AUV2 : Shutdown

@enduml
