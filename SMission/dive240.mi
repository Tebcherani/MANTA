UseSim 1

# Initial position and attitude
sensor: m_pos_n(m)    0.0
sensor: m_pos_e(m)    0.0
sensor: m_depth(m)    0.0
sensor: real_x(m)     0.0
sensor: real_y(m)     0.0
sensor: real_z(m)     0.0

# Control gains
sensor: uo_control_kpp          1.0
sensor: uo_control_kdp          0.9
sensor: uo_control_kip          0.0
sensor: uo_control_pitch_lim(deg) 30
sensor: uo_control_kph          0.75
sensor: uo_control_kdh          1.5

# Vehicle physical params
sensor: real_veh_w(N)  1173.0
sensor: real_veh_b(N)  1173.0

state: dive_and_cruise

behavior: mission_timer 1
  b_arg: time(s) 240

behavior: depth_envelope 2
  b_arg: max_depth(m)          50.0
  b_arg: min_depth(m)           0.5
  b_arg: alt_env_active(bool)   0.0
  b_arg: min_altitude(m)        2.0
  b_arg: depth_cutoff_active(bool) 0.0
  b_arg: cutoff_depth(m)       55.0

behavior: setpoint 3
  b_arg: heading(rad)  90.0
  b_arg: depth(m)     15.0
  b_arg: speed(m/s)    1.5
  b_arg: time(s)      240.0
