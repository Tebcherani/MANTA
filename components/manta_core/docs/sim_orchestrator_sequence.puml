@startuml
title MANTA ROS 2 Simulation Sequence Diagram

skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

participant "SimOrchestratorNode" as Orchestrator
participant "WhaleNode" as Whale
participant "OdysseyNode\nauv_1" as AUV1
participant "OdysseyNode\nauv_2" as AUV2
participant "WhaleDetectionNode" as Detection

== Vehicle initialization ==

Orchestrator ->> AUV1 : Startup data (ready, initial time, calendar time)
AUV1 -> AUV1 : Initialize vehicle simulation
AUV1 ->> Orchestrator : Vehicle ready

Orchestrator ->> AUV2 : Startup data (ready, initial time, calendar time)
AUV2 -> AUV2 : Initialize vehicle simulation
AUV2 ->> Orchestrator : Vehicle ready
Orchestrator -> Orchestrator : Wait until both vehicles are ready

== Simulation loop ==

loop
    Orchestrator -> Whale : Request next whale call
    Whale --> Orchestrator : Next call or no future call
    Orchestrator -> Orchestrator : Store scheduling response

    Orchestrator ->> Whale : Simulation step 

    Orchestrator ->> AUV1 : Simulation step
    AUV1 ->> Orchestrator : Simulation step result

    Orchestrator ->> AUV2 : Simulation step
    AUV2 ->> Orchestrator : Simulation step result

    Orchestrator -> Orchestrator : Wait for all active vehicle results
    Orchestrator -> Orchestrator : Advance shared simulation clock

    Orchestrator ->> Detection : Whale call (ID, cycle, time, position)
    Detection ->> Orchestrator : WhaleCallProcessed (bearing receiver IDs)

    AUV1 ->> Orchestrator : BearingProcessed
    AUV2 ->> Orchestrator : BearingProcessed

    Orchestrator -> Orchestrator : Wait for detector completion\nand required estimator acknowledgments
end

@enduml