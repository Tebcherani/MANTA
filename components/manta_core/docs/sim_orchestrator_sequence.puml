@startuml
title MANTA — Sequential Whale and Vehicle Steps

skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

participant "SimOrchestratorNode" as Orchestrator
participant "WhaleNode" as Whale
participant "WhaleDetectionNode" as Detection
participant "OdysseyNode\nauv_1" as AUV1
participant "OdysseyNode\nauv_2" as AUV2

loop Until mission termination
    Orchestrator ->> Whale : Whale SimStep (maximum batch size)
    Whale ->> Orchestrator : WhaleStepResult (completed steps, optional call)

    Orchestrator ->> AUV1 : Vehicle SimStep (completed whale steps)
    Orchestrator ->> AUV2 : Vehicle SimStep (completed whale steps)
    AUV1 ->> Detection : VehicleState
    AUV2 ->> Detection : VehicleState
    AUV1 ->> Orchestrator : SimStepResult (after peer exchange, if scheduled)
    AUV2 ->> Orchestrator : SimStepResult (after peer exchange, if scheduled)
    Orchestrator -> Orchestrator : Wait for active vehicle step results; advance shared clock
end

@enduml
