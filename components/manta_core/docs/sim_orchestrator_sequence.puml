@startuml
title MANTA Trailing Mission — Scheduled Bearing Communication

skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

participant "SimOrchestratorNode" as Orchestrator
participant "WhaleNode" as Whale
participant "WhaleDetectionNode" as Detection
participant "OdysseyNode\nauv_1" as AUV1
participant "OdysseyNode\nauv_2" as AUV2

loop

    Orchestrator -> Whale : Request next whale call
    Whale --> Orchestrator : Next call or no future call

    par Whale simulation
        Orchestrator ->> Whale : SimStep

    else AUV simulation
        Orchestrator ->> AUV1 : SimStep
        AUV1 ->> Orchestrator : SimStepResult
    end

    Orchestrator -> Orchestrator : Wait for all active vehicles' step results
    Orchestrator -> Orchestrator : Check termination; advance shared clock if continuing

    Orchestrator ->> Detection : WhaleCall (position, cycle, time)

    opt AUV detects call
        AUV1 ->> Orchestrator : BearingProcessed (measurement stored)
    end

        Detection ->> Orchestrator : WhaleCallProcessed (receiver IDs)
    Orchestrator -> Orchestrator : Wait for detector and bearing acknowledgements
end

@enduml
