@startuml
title SimOrchestratorNode Constructor Activity Diagram

skinparam monochrome true
skinparam shadowing false
skinparam svgLinkTarget _self

start

partition "SimOrchestratorNode()" {
    :Load list of vehicles;    
    partition "Create ROS interfaces" {
        :Create QoS configuration;
        
        :Create publishers;
        note right
            - Calendar start time
            - Advance whale simulation first
            - Advance vehicles after whale step result
            - Sim time
            - Startup complete
            - Request shutdown
        end note

        :Create subscribers;
        note right
            - Init complete (for every AUV)
            - Whale estimator ready (for every AUV, when configured)
            - Step results (for every AUV)
            - Whale step result
            - Whale and detection node ready
            - Whale call processed by detector
            - Bearing processed (by one AUV)
        end note

    }
    
    :Initialize simulation configuration;
    :Initialize world model;
    :Initialize shared simulation state;
    #lightgreen:Publish startup readiness,\nsimulation time, and calendar time;
}

stop

@enduml
