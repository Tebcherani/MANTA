@startuml
title WhaleNode Constructor Activity Diagram

skinparam monochrome true
skinparam shadowing false
skinparam svgLinkTarget _self

start

partition "WhaleNode()" {
    :Load whale-model configuration;
    note right
        - Mission duration
        - Movement and calling parameters
        - Output sampling period
    end note

    :Seed random number generator;

    partition "Initialize single whale" {
        :Set ID to whale_1;
        :Set start time to zero;
        :Initialize lifecycle and call index;
        :Convert initial heading to radians;

        :Sample positive swimming speed;
        note right
            Normal(speed_mean, speed_std)
            Reject nonpositive draws
        end note

        partition "Generate movement trajectory" {
            :Calculate AR(1) heading innovation scale;
            note right
                sigma_innovation =
                sigma_heading * sqrt(1 - rho^2)

                sigma_heading is converted to radians.
            end note

            :Initialize time and position;
            :Set heading error to zero;

            while (Trajectory generation continues?) is (yes)
                :Calculate heading;
                note right
                    heading = initial heading + heading error
                end note

                :Calculate north/east velocity;
                :Store trajectory point;

                if (Mission duration reached?) then (yes)
                    break
                else (no)
                    :Determine next heading-update boundary;
                    :Limit next time to mission duration;
                    :Advance position using current velocity;
                    :Advance time;

                    if (Mission duration reached?) then (yes)
                        :Store final trajectory point;
                        break
                    else (no)
                        :Update AR(1) heading error;
                        note right
                            error_next = rho * error
                            + sigma_innovation * Normal(0, 1)
                        end note
                    endif
                endif
            endwhile (no)
        }

        :Verify trajectory is nonempty;

        partition "Generate whale call times" {
            :Set calling interval to the full mission;
            :Select initial active or silent calling state;
            note right
                Probability of active calling =
                mean_active / (mean_active + mean_silent)

                With configured means:
                1842 / (1842 + 7860) = approximately 0.19
            end note

            while (Calling interval remains?) is (yes)
                if (Active calling bout?) then (yes)
                    :Sample positive active-bout duration;
                    note right
                        Exponential distribution
                        Mean = bout_mean_duration
                    end note

                    :Limit bout end to mission duration;
                    :Generate and store calls before bout end;
                    note right
                        Positive exponential intercall intervals

                        Rate = bout_active_call_rate_per_hour
                        converted to calls per second
                    end note
                else (no)
                    :Sample positive silent duration;
                    note right
                        Exponential distribution
                        Mean = bout_mean_silent_duration
                    end note

                    :Limit silent interval end to mission duration;
                endif

                :Advance to interval end;
                :Switch active/silent calling state;
            endwhile (no)
        }

        :Initialize published position and velocity\nfrom first trajectory point;
        :Store exactly one whale;
    }

    partition "Create ROS interfaces" {
        :Create whale-state publisher;
        note right
            WhaleStateArray contains one whale.
        end note

        :Create subscribers;
        note right
            - Simulation step
            - Shutdown request
        end note

        :Create next-whale-call service;
    }

    :Log "Initialized one whale";
}

stop

@enduml