@startuml
title WhaleNode Constructor Activity Diagram

skinparam monochrome true
skinparam shadowing false
skinparam svgLinkTarget _self

start

partition "WhaleNode()" {
    :Load whale-model configuration;
    note right
        - Picket-line endpoints and mission duration
        - Whale count and initialization mode
        - Grouping, movement, and calling parameters
    end note

    :Seed random-number generator;

    partition "Initialize whales" {
        if (Picket-line initialization?) then (yes)
            :Calculate line length and parallel/perpendicular unit vectors;
        endif

        partition "Generate whale groups" {
            :Calculate group count;
            note right: max(1, ceil(whale count / group mean size))

            :Calculate number of heading intervals;
            note right: ceil(mission duration / turn interval) + 1

            while (More groups?) is (yes)
                :Sample group crossing location;
                note right: Uniform(0, line length); fixed mode uses length 0

                :Sample starting side and group start time;
                note right
                    Side: Bernoulli(0.5) -> +1 or -1
                    Time: Uniform(0, mission duration)
                end note

                :Generate shared heading errors;
                note right
                    Initial error = 0
                    AR(1): next = correlation * current
                    + heading STD * sqrt(1 - correlation^2) * Normal(0, 1)
                end note
            endwhile (no)
        }

        partition "Create individual whales" {
            while (More whales?) is (yes)
                :Assign group round-robin;
                :Choose start time;
                note right
                    Active entire mission: time 0
                    Otherwise: sample around group start time,
                    within the mission
                end note

                :Sample positive swimming speed;
                note right: Normal(speed mean, speed STD); redraw if <= 0

                if (Fixed initialization?) then (yes)
                    :Use configured north/east position and heading;
                    note right: Heading converted from degrees to radians on load
                else (picket line)
                    :Sample crossing distance near group location;
                    note right: Normal(group crossing, position STD); redraw outside line
                    :Calculate initial position and heading toward line;
                    note right: Offset by start distance on the group's side
                endif

                :Create whale with ID, group, start time, and side;

                partition "Generate movement trajectory" {
                    :Calculate shared/individual heading weights;
                    note right
                        Group weight = sqrt(shared heading fraction)
                        Individual weight = sqrt(1 - fraction)
                    end note

                    :Initialize time, position, and individual heading error;

                    while (Trajectory complete?) is (no)
                        :Combine shared and individual heading errors;
                        :Calculate north/east velocity from speed and heading;
                        :Store trajectory point;

                        if (Mission duration reached?) then (yes)
                            break
                        else (no)
                            :Move at current velocity to next heading boundary;
                            if (Nonpersistent picket-line whale exits corridor?) then (yes)
                                :Store final point with zero velocity;
                                break
                            else (no)
                                if (Mission duration reached after move?) then (yes)
                                    :Store final point at mission end;
                                    break
                                else (no)
                                    :Update individual AR(1) heading error;
                                endif
                            endif
                        endif
                    endwhile (yes)
                }

                :Set whale's initial published position and velocity;
            endwhile (no)
        }

        partition "Generate population call times" {
            :Find first whale activation and last trajectory end;
            :Choose initial active/silent bout;
            note right
                P(active) = mean active duration /
                (mean active duration + mean silent duration)
            end note

            while (Calling interval remains?) is (yes)
                if (Active bout?) then (yes)
                    :Sample active duration from exponential distribution;
                    :Generate calls from a Poisson process;
                    note right: Rate = configured active calls per hour
                else (silent)
                    :Sample silent duration from exponential distribution;
                endif
                :Switch between active and silent bouts;
            endwhile (no)
        }

        partition "Assign calls to whales" {
            while (More population calls?) is (yes)
                :Find whales active at this call time;
                if (Any active whales?) then (yes)
                    :Choose one uniformly and store its call time;
                else (no)
                    :Discard call;
                endif
            endwhile (no)
        }
    }

    :Open state log and record initialized whale state;

    partition "Create ROS interfaces" {
        :Create whale-state publisher;
        :Subscribe to simulation steps and shutdown;
        :Create next-whale-call service;
    }
}

stop

@enduml
