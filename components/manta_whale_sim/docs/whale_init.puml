@startuml
title WhaleNode Constructor Activity Diagram

skinparam monochrome true
skinparam shadowing false
skinparam svgLinkTarget _self

start

partition "WhaleNode()" {
    :Load whale-model configuration;
    note right
        - Mission duration
        - Movement and calling parameters
        - Output sampling period
    end note

    :Seed random number generator;

    partition "Initialize single whale" {
        :Sample swimming speed;
        note right
            Normal(speed_mean, speed_std)
            Reject nonpositive draws
            Speed remains fixed during the mission.
        end note

        partition "Generate movement trajectory" {
            :Calculate AR(1) innovation scale;
            note right
                sigma_innovation = sigma_heading * sqrt(1 - rho^2)
            end note

            while (Trajectory generation continues?) is (yes)
                :Calculate north/east velocity;
                note right
                    velocity_north = speed * cos(heading_error)
                    velocity_east = speed * sin(heading_error)
                end note

                    :Advance position using current velocity;
                    :Advance time;

                    if (Mission duration reached?) then (yes)
                        break
                    else (no)
                        :Update AR(1) heading error;
                        note right
                            error_next = rho * error
                            + sigma_innovation * Normal(0, 1)
                        end note
                    endif
            endwhile (no)
        }

        partition "Generate whale call times" {
            :Set calling interval from zero to mission duration;
            :Create exponential duration and intercall distributions;
            :Select initial active or silent calling state;
            note right
                Probability of active calling =
                mean_active / (mean_active + mean_silent)

                Calling state is separate from
                the whale's lifecycle active flag.
            end note

            while (Calling interval remains?) is (yes)
                :Sample positive duration for current calling state;
                note right
                    Active: mean = bout_mean_duration
                    Silent: mean = bout_mean_silent_duration
                end note

                if (Active calling bout?) then (yes)
                    :Sample positive intercall interval;
                    :Calculate first call time;

                    while (Call time precedes interval end?) is (yes)
                        :Sample next positive intercall interval;
                        :Advance call time;
                    endwhile (no)

                    note right
                        Exponential intercall intervals
                        Rate = bout_active_call_rate_per_hour / 3600
                    end note
                else (no)
                    :Generate no calls during silence;
                endif

                :Advance to interval end;
                :Switch active/silent calling state;
            endwhile (no)
        }
    }

    partition "Create ROS interfaces" {
        :Create whale-state publisher;
        note right
            WhaleStateArray contains one whale.
        end note

        :Create subscribers;
        note right
            - Simulation step
            - Shutdown request
        end note

        :Create next-whale-call service;
    }
}

stop

@enduml