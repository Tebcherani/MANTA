@startuml
title MANTA — Whale Step and Call Publication

skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

participant "SimOrchestratorNode" as Orchestrator
participant "WhaleNode" as Whale
participant "WhaleDetectionNode" as Detection

Orchestrator ->> Whale : Whale SimStep (maximum batch size)
Whale -> Whale : Find earliest call within this batch
Whale -> Whale : Shorten batch to the call step, if needed
Whale -> Whale : Advance whale positions
Whale -> Whale : Publish ground truth and log trajectory samples
opt Scheduled call falls in the completed step
    Whale ->> Detection : WhaleCall (position, cycle, time)
end
Whale ->> Orchestrator : WhaleStepResult (completed steps, optional call)

Orchestrator ->> Whale : Shutdown

@enduml
