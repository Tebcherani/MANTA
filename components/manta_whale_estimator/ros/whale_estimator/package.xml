<?xml version="1.0"?>
<package format="3">
  <name>whale_estimator</name>
  <version>0.0.0</version>
  <description>Per-vehicle whale position and velocity estimator</description>
  <maintainer email="odyssey@todo.todo">odyssey</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>whale_estimator_interfaces</exec_depend>
