@startuml
title MANTA — Whale Estimator Initialization

skinparam monochrome true
skinparam shadowing false

start

partition "WhaleEstimatorNode()" {
    :Load configuration;

    partition "Create ROS interfaces" {
        :Create publisher;
        note right
            - Kalman whale estimate
        end note

        :Create subscribers;
        note right
            - Whale position from bearings
            - Request shutdown
        end note
    }
}

stop

@enduml
