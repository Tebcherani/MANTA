@startuml
title MANTA — Whale Estimator Update and Prediction

skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

participant "OdysseyNode" as Odyssey
participant "WhaleEstimatorNode" as RosEstimator
participant "Python FilterPy model" as Estimator
participant "WhaleEstimatorState" as State
participant "Odyssey guidance snapshot" as Cached

Odyssey -> RosEstimator : Publish triangulated position and variance
RosEstimator -> State : Store position, variance, cycle, and time
RosEstimator -> Estimator : update_estimator(state)
Estimator -> State : Clear bearing_whale_position_accepted_b
Estimator -> Estimator : Validate finite fix and variance,
and strictly increasing timestamp
alt First accepted fix
    Estimator -> State : Set north/east positions and measurement variances,
baseline velocities, initial velocity variances,
measurement time, estimator_initialized_b
else Later accepted fix
    Estimator -> Estimator : Build mean-reverting F, control, and process noise Q
    Estimator -> Estimator : FilterPy predict, then update with position variance R
    Estimator -> State : Save updated axes and measurement time
end
Estimator -> State : Drop stale recent fixes; append current fix
opt At least three recent fixes
    Estimator -> Estimator : Fit north/east velocity using actual timestamps
    Estimator -> State : Replace velocity and variance with rolling-fit result
end
Estimator -> State : Set bearing_whale_position_accepted_b
Estimator -->> RosEstimator : Accepted
RosEstimator -> Odyssey : Publish position, velocity, variances, and model tuning
Odyssey -> Cached : Store estimate for guidance between fixes

Odyssey -> Cached : Read latest measurement time and model parameters
Odyssey -> Odyssey : Reject time before last accepted fix
Odyssey -> Odyssey : Project position and velocity returning toward nominal
Odyssey -> Cached : Read projected position for formation guidance

@enduml
