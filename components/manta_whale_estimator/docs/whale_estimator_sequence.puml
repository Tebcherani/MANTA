@startuml
title MANTA — Whale Estimator Update and Prediction

skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

participant "OdysseyNode" as Odyssey
participant "WhaleEstimatorNode" as RosEstimator
participant "Python FilterPy model" as Estimator
participant "WhaleEstimatorState" as State
participant "Odyssey guidance snapshot" as Cached

Odyssey -> RosEstimator : Publish triangulated position and variance
RosEstimator -> State : Store position, variance, cycle, and time
RosEstimator -> Estimator : update_estimator(state)
alt First accepted fix
    Estimator -> State : Initialize north/east positions from fix
    Estimator -> State : Set position variances from fix
    Estimator -> State : Set velocities to configured baselines
    Estimator -> State : Set initial velocity variances and measurement time
    Estimator -> State : Set estimator_initialized_b
else Later accepted fix
    Estimator -> State : Select north axis and load its update values
    Estimator -> Estimator : Calculate how position and velocity estimates change under the baseline-return rule
    Estimator -> Estimator : Calculate white-acceleration process noise Q
    Estimator -> Estimator : FilterPy predicts north position and velocity
    Estimator -> Estimator : Correct north prediction using measured position and variance R
    Estimator -> State : Save candidate north estimate in state
    Estimator -> State : Select east axis and load its update values
    Estimator -> Estimator : Calculate how position and velocity estimates change under the baseline-return rule
    Estimator -> Estimator : Calculate white-acceleration process noise Q
    Estimator -> Estimator : FilterPy predicts east position and velocity
    Estimator -> Estimator : Correct east prediction using measured position and variance R
    Estimator -> State : Save both axes and measurement time if both updates succeed
end
Estimator -> State : Drop fixes older than velocity_window_max_age_s
Estimator -> State : Append current fix; keep at most five fixes
opt At least three recent fixes
    Estimator -> Estimator : Fit north/east velocity using actual timestamps
    Estimator -> State : Replace velocity and variance with fit result
    Estimator -> State : Clear position/velocity covariance
end
Estimator -> State : Set bearing_whale_position_accepted_b
Estimator -->> RosEstimator : Return through state acceptance flag
RosEstimator -> Odyssey : Publish estimate, variances, baseline velocities,\nreturn duration, measurement time, and cycle

@enduml
