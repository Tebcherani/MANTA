@startuml
title MANTA Trailing Mission — Scheduled Bearing Communication

skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

participant "SimOrchestratorNode" as Orchestrator
participant "WhaleDetectionNode" as Detection
participant "OdysseyNode\nauv_1" as AUV1
participant "OdysseyNode\nauv_2" as AUV2
participant "WhaleEstimatorNode\nauv_1" as Estimator1
participant "WhaleEstimatorNode\nauv_2" as Estimator2

Orchestrator ->> AUV1 : SimStep
AUV1 -> AUV1 : Advance dynamics and simulation time
AUV1 -> AUV1 : At control updates, project latest Kalman estimate\nusing baseline velocity and return time
AUV1 -> AUV1 : Update trailing waypoint and control

opt Communication boundary reached and measurement available
    AUV1 ->> AUV2 : Latest bearing, receiver position, and measurement time
end

AUV1 ->> Detection : VehicleState
AUV1 ->> Orchestrator : SimStepResult

opt AUV detects call
    Detection ->> AUV1 : BearingObservation
    AUV1 -> AUV1 : Find own position at call cycle
    AUV1 -> AUV1 : Store bearing with vehicle position\nfor its call cycle
    AUV1 ->> Orchestrator : BearingProcessed (measurement stored)
end

opt Matching local and remote bearings available
    AUV1 -> AUV1 : Intersect bearings from the same call cycle
    AUV1 ->> Estimator1 : WhaleBearingPositionEstimate
    Estimator1 -> Estimator1 : Update position and velocity filter\nusing the timestamped position estimate
    Estimator1 ->> AUV1 : WhaleKalmanEstimate
    AUV1 -> AUV1 : Store latest Kalman estimate for guidance
end

opt Matching local and remote bearings available on auv_2
    AUV2 -> AUV2 : Intersect bearings from the same call cycle
    AUV2 ->> Estimator2 : WhaleBearingPositionEstimate
    Estimator2 -> Estimator2 : Update position and velocity filter
    Estimator2 ->> AUV2 : WhaleKalmanEstimate
    AUV2 -> AUV2 : Store latest Kalman estimate for guidance
end

@enduml
