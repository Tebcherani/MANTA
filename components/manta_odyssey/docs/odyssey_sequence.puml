@startuml
title MANTA Vehicle Initialization and Stepping

skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

participant "SimOrchestratorNode" as Orchestrator
participant "OdysseyNode\n(one per vehicle)" as Odyssey
participant "AcousticsNode" as Detection

== Vehicle initialization ==

Orchestrator ->> Odyssey : Startup ready
Orchestrator ->> Odyssey : Initial simulation time
Orchestrator ->> Odyssey : Calendar start time

activate Odyssey
Odyssey -> Odyssey : Initialize Odyssey simulation,\ntime, mission, vehicle, and world
Odyssey ->> Orchestrator : Vehicle ready
deactivate Odyssey

Orchestrator -> Orchestrator : Wait until all vehicles are ready

== Simulation batch ==

Orchestrator ->> Odyssey : SimStep (world state, start cycle/time,\ntimestep, control period, step count)
activate Odyssey
Odyssey -> Odyssey : Convert supplied world state

loop
    Odyssey -> Odyssey : Advance vehicle dynamics
    opt
        Odyssey -> Odyssey : Update sensors, navigation,\ncontrol, and mission logic
    end
    Odyssey -> Odyssey : Update simulation time
end

Odyssey -> Odyssey : Save completed position snapshot
Odyssey ->> Detection : VehicleState (ID, cycle, time, position)
Odyssey ->> Orchestrator : SimStepResult
deactivate Odyssey

@enduml