@startuml
title MANTA Trailing Mission — Scheduled Bearing Communication

skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

participant "SimOrchestratorNode" as Orchestrator
participant "WhaleNode" as Whale
participant "AcousticDetectionNode" as Detection
participant "OdysseyNode" as AUV1

Whale ->> Detection : WhaleCall
AUV1 ->> Detection : VehicleState
Detection -> Detection : Evaluate detection range
Detection -> Detection : Calculate bearings
Detection -> Detection : Add noise to bearings
Detection ->> AUV1 : BearingObservation
Detection ->> Orchestrator : WhaleCallProcessed (receiver IDs)

@enduml