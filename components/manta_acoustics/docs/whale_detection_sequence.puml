@startuml
title MANTA Trailing Mission — Scheduled Bearing Communication

skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

participant "SimOrchestratorNode" as Orchestrator
participant "AcousticDetectionNode" as Detection
participant "OdysseyNode" as AUV1

AUV1 ->> Detection : VehicleState
Detection -> Detection : Evaluate detection range and calculate bearings
Detection ->> AUV1 : BearingObservation
Detection ->> Orchestrator : WhaleCallProcessed (receiver IDs)

@enduml