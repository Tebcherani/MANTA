@startuml

skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

participant "SimOrchestratorNode" as Orchestrator
participant "WhaleDetectionNode" as Detection
participant "OdysseyNode\nauv_1" as AUV1
participant "OdysseyNode\nauv_2" as AUV2

AUV1 ->> Detection : Vehicle state (cycle, time, position)
activate Detection
AUV2 ->> Detection : Vehicle state (cycle, time, position)
Orchestrator ->> Detection : Whale call (cycle, time, position)

Detection -> Detection : Wait for both vehicle states\nmatching the call cycle
Detection -> Detection : Check range and calculate\nbearing for each receiver

Detection ->> AUV1 : BearingObservation

Detection ->> AUV2 : BearingObservation

Detection ->> Orchestrator : WhaleCallProcessed\n(includes bearing receiver IDs)
deactivate Detection