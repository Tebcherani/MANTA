# Generated MANTA picket-line mission for auv_3
UseSim 1

# Start at the beginning of this vehicle's assigned segment.
sensor: m_pos_n(m) 0.000000
sensor: m_pos_e(m) 21000.000000
sensor: m_depth(m) 50.000000
sensor: real_x(m) 0.000000
sensor: real_y(m) 21000.000000
sensor: real_z(m) 50.000000

state: picket_line

# Stop after the configured scenario duration.
behavior: mission_timer 1
  b_arg: time(s) 259200.000000

# Maintain safe depth limits.
behavior: depth_envelope 2
  b_arg: max_depth(m) 70.000000
  b_arg: min_depth(m) 0.5
  b_arg: alt_env_active(bool) 0
  b_arg: min_altitude(m) 2.0
  b_arg: depth_cutoff_active(bool) 0
  b_arg: cutoff_depth(m) 75.000000

# Continuously patrol the assigned picket-line segment.
behavior: picket_line 3
  b_arg: start_n(m) 0.000000
  b_arg: start_e(m) 21000.000000
  b_arg: end_n(m) 0.000000
  b_arg: end_e(m) 63000.000000
  b_arg: depth(m) 50.000000
  b_arg: speed(m/s) 0.250000
  b_arg: capture(m) 5.000000
