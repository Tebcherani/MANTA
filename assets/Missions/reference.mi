# =====================================================================
#  reference.mi  --  Simplified: dive + yo-yo only
#
#  Goal: isolate the yo-yo behavior to verify it dives to 100 m and
#  oscillates 50<->100 properly. Strips out the constant-depth legs
#  and circles. ascend at priority 2 takes over when yo_yo's
#  max_time expires.
#
#  Profile:
#    Phase A: Spiral dive  -> 50 m, constant rudder, 1.5 m/s   (~180 s)
#    Phase B: Yo-yo        : 50<->100 m, +/-30 deg pitch        (~620 s)
#    Phase C: Drop weight, ascend (ascend takes over when stack clears)
#
#  Total budget: ~180 (dive) + 900 (yo_yo padded) + ~300 (ascend)
#                ~= 1400 s. mission_timer set to 1800 s for margin.
# =====================================================================

UseSim 1

sensor: m_depth(m)            0.0

state: reference

# ---- Safety / terminator (low priority numbers) ----

behavior: mission_timer 1
  b_arg: time(s)                  1800

behavior: ascend 2
  b_arg: heading(rad)             0
  b_arg: rudder_angle(rad)        0
  b_arg: ascent_angle(rad)        0.349
  b_arg: speed(m/s)               1.0
  b_arg: end_depth(m)             3
  b_arg: drop_descent_weight(bool) 1
  b_arg: drop_ascent_weight(bool)  0
  b_arg: abort_mission_active(bool) 0

behavior: depth_envelope 3
  b_arg: max_depth(m)             110
  b_arg: min_depth(m)             0
  b_arg: alt_env_active(bool)     0
  b_arg: min_altitude(m)          -1
  b_arg: depth_cutoff_active(bool) 1
  b_arg: cutoff_depth(m)          120

# ---- Goal stack (HIGH priority number runs first) ----

# Phase B: yo-yo 50<->100 m, ~10 min -- runs after its companion
# yo_yo sign convention: NEGATIVE desired_pitch = dive first
# (opposite of descend, which uses positive descent_angle for diving).
behavior: yo_yo 4
  b_arg: desired_pitch(rad)       -0.523599
  b_arg: top_depth(m)             50
  b_arg: bottom_depth(m)          100
  b_arg: min_altitude(m)          -1
  b_arg: cycles(int)              10000
  b_arg: max_time(s)              900

# Phase B companion: owns heading and speed while yo_yo owns pitch.
behavior: setpoint 5
  b_arg: heading(rad)             0
  b_arg: depth(m)                 75
  b_arg: speed(m/s)               1.5
  b_arg: time(s)                  900
  b_arg: cycles(int)              1
  b_arg: turn(rad)                0
  b_arg: desired_pitch(rad)       0

# Phase A: spiral dive to 50 m -- runs FIRST (highest priority number)
behavior: descend 6
  b_arg: heading(rad)             0
  b_arg: rudder_angle(rad)        0.174533
  b_arg: descent_angle(rad)       0.349066
  b_arg: speed(m/s)               1.5
  b_arg: end_depth(m)             50
  b_arg: min_altitude(m)          -1
  b_arg: drop_descent_weight(bool) 0
  b_arg: drop_ascent_weight(bool)  0
  b_arg: max_time(s)              600
