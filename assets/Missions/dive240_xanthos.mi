UseSim 1

# ============================================================
# dive240_xanthos.mi
# 240-second dive to 15 m using the controller settings logged
# by Xanthos during the September 1998 Massachusetts Bay LOOPS
# cruise (X9827208.obd).
#
# Differences from dive240.mi:
#   - Outer-loop depth-mapping gain dropped 6x (0.5 -> 0.08).
#     This is the dominant change; the original simulator value
#     drove the controller into pitch-limit saturation.
#   - Pitch loop kpp/kdp/kip raised to match real-vehicle gains.
#   - Heading loop kih added (small integral term).
#   - Pitch limit kept at 30 deg (Xanthos's standard envelope for
#     yo-yo profiles, which routinely use 20-30 deg dive/climb).
#     The 20 deg seen in X9827208.obd was a mission-specific override.
#   - Filter time constant uo_tau halved (5 s -> 2.5 s).
#   - Max heading rate doubled (0.1 -> 0.2 rad/s).
#   - Bug fix: heading was 90 RADIANS (~5156 deg). Now 90 deg
#     declared with (deg) so the loader converts to radians.
# ============================================================

# Initial position and attitude
sensor: m_pos_n(m)    0.0
sensor: m_pos_e(m)    0.0
sensor: m_depth(m)    0.0
sensor: real_x(m)     0.0
sensor: real_y(m)     0.0
sensor: real_z(m)     0.0

# ----- Controller gains: Xanthos 1998 values -----
# Pitch loop (depth -> pitch via elevator)
sensor: uo_control_kpp                      1.5
sensor: uo_control_kdp                      2.0
sensor: uo_control_kip                      0.05
sensor: uo_control_pitch_lim(deg)          30

# Heading loop (heading -> rudder)
sensor: uo_control_kph                      0.7
sensor: uo_control_kdh                      2.0
sensor: uo_control_kih                      0.02

# Outer depth-mapping loop (the 6x reduction)
sensor: uo_depth_map_k                      0.08
sensor: uo_depth_int_k                      0.005

# Filter and rate limits
sensor: uo_tau                              2.5
sensor: uo_max_hr                           0.2
sensor: uo_max_dr                           0.5

# ----- Vehicle physical params -----
sensor: real_veh_w(N)  1173.0
sensor: real_veh_b(N)  1173.0

# ----- Simulator actuator timing fix -----
# Earlier hardcoded 0.4 s transport delay was 2-4x too pessimistic
# vs. the X9827208 elevator response. 0.1 s matches the visible lag
# in panel 3 of the real-vehicle diagnostic plot.
sensor: vs_act_delay(s)                     0.1

state: dive_and_cruise

behavior: mission_timer 1
  b_arg: time(s) 240

behavior: depth_envelope 2
  b_arg: max_depth(m)              50.0
  b_arg: min_depth(m)               0.5
  b_arg: alt_env_active(bool)       0.0
  b_arg: min_altitude(m)            2.0
  b_arg: depth_cutoff_active(bool)  0.0
  b_arg: cutoff_depth(m)           55.0

behavior: setpoint 3
  b_arg: heading(deg)  90.0
  b_arg: depth(m)      15.0
  b_arg: speed(m/s)     1.5
  b_arg: time(s)      240.0
