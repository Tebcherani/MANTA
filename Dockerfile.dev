FROM ros:jazzy-ros-base

ENV DEBIAN_FRONTEND=noninteractive
ENV ODY_ROOT=/odyssey

ARG HOST_UID=501
ARG HOST_GID=20

RUN apt-get update && apt-get install -y \
    build-essential \
    gcc \
    g++ \
    make \
    liblapacke-dev \
    liblapack-dev \
    libblas-dev \
    ros-dev-tools \
    ros-jazzy-rqt-graph \
    python3-colcon-common-extensions \
    python3-pip \
    python3-numpy \
    python3-scipy \
    python3-matplotlib \
    && rm -rf /var/lib/apt/lists/*

COPY components/manta_whale_estimator/ros/whale_estimator/requirements.txt /tmp/whale_estimator_requirements.txt
RUN python3 -m pip install --break-system-packages --no-cache-dir --no-deps \
    -r /tmp/whale_estimator_requirements.txt && \
    rm /tmp/whale_estimator_requirements.txt

RUN EXISTING_GROUP=$(getent group ${HOST_GID} | cut -d: -f1) && \
    if [ -z "$EXISTING_GROUP" ]; then \
        groupadd -g ${HOST_GID} odyssey && \
        EXISTING_GROUP=odyssey; \
    fi && \
    EXISTING_USER=$(getent passwd ${HOST_UID} | cut -d: -f1) && \
    if [ -n "$EXISTING_USER" ]; then \
        usermod -l odyssey "$EXISTING_USER" && \
        usermod -d /home/odyssey -m odyssey && \
        usermod -g "$EXISTING_GROUP" odyssey; \
    else \
        useradd \
            -m \
            -u ${HOST_UID} \
            -g "$EXISTING_GROUP" \
            -s /bin/bash \
            odyssey; \
    fi

WORKDIR /odyssey

USER odyssey

RUN echo "source /opt/ros/jazzy/setup.bash" >> /home/odyssey/.bashrc

CMD ["/bin/bash"]
